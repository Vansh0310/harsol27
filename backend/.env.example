NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# This dev sandbox cannot run Docker/Postgres locally - use a free managed
# Postgres (e.g. Neon or Supabase) for development, per the plan doc's checklist.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Auth secrets - generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Rate limiting for the public lead-submission endpoint
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_REQUESTS=5

# Transactional email (Phase 5) - Resend is the only provider implemented.
# Get an API key at https://resend.com/api-keys (starts with "re_").
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""

# Sender address. Until you verify your own domain in the Resend dashboard,
# use the shared test domain below - it works immediately, but Resend will
# reject any `to` address other than the email your Resend account was
# signed up with. That's not just the submitter's address - it also means
# ADMIN_NOTIFICATION_EMAIL below must be set to that same signup address for
# now, or the admin alert will bounce too. Once you verify a domain, switch
# EMAIL_FROM to e.g. "no-reply@yourdomain.com" and both emails will work for
# any real recipient - no code change needed either way.
EMAIL_FROM="onboarding@resend.dev"

# Inbox that receives the "new lead" alert for every submission. While on the
# test domain above, this MUST be the email your Resend account was signed
# up with, or every admin alert will be rejected by Resend (403).
ADMIN_NOTIFICATION_EMAIL=""

# Admin auth (Phase 6). JWT_ACCESS_SECRET/JWT_REFRESH_SECRET above sign the
# tokens; these tune their lifetimes and the account-lockout behavior. All
# have sensible defaults - only set these if you want to change them.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15
